{
  "name": "wasm-satsview",
  "version": "0.1.0",
  "description": "WebAssembly GNSS satellite sky-view control with TypeScript entrypoints",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc",
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "cargo test --locked && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings && tsc --noEmit"
  },
  "devDependencies": { "typescript": "5.9.3", "playwright": "1.61.0" }
}
